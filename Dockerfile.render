FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN mvn -B -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build --chown=10001:10001 /build/target/cazaobjetos-0.1.0-SNAPSHOT.jar /app/app.jar
RUN mkdir -p /app/.local && chown 10001:10001 /app/.local && chmod 700 /app/.local
USER 10001:10001
ENV SERVER_ADDRESS=0.0.0.0 SERVER_PORT=10000
EXPOSE 10000
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
