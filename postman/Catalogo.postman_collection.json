            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/found-items",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Mochila {{catalogTag}}\",\n  \"description\": \"Con cierre gris\",\n  \"category\": \"CLOTHING\",\n  \"location\": \"Edificio I, salón 3\",\n  \"occurredOn\": \"2026-10-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function(){",
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.environment.set(\"catalogFoundOne\",pm.response.json().id);",
              "if(pm.response.code === 201) {",
              "",
              "}",
              "})();"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"catalogTag\",\"catalog\"+Date.now());"
            ]
          }
        }
      ]
    },
