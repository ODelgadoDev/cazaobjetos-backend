    {
      "name": "09 · Buscar ambos hallazgos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/found-items?q={{catalogTag}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function(){",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code === 200) {",
              "const page=pm.response.json();pm.test(\"Total filtrado\",()=>pm.expect(page.total).to.eql(2));pm.test(\"Dos resultados\",()=>pm.expect(page.items.length).to.eql(2));",
              "}",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "10 · Combinar categoría, lugar, estado, resguardo y fechas",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/found-items?q={{catalogTag}}&category=CLOTHING&location=Edificio&status=AVAILABLE&custody=OFFICE&dateFrom=2026-10-01&dateTo=2026-10-01"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function(){",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code === 200) {",
              "const page=pm.response.json();pm.test(\"Una mochila\",()=>{pm.expect(page.total).to.eql(1);pm.expect(page.items[0].id).to.eql(pm.environment.get(\"catalogFoundOne\"));});",
              "}",
              "})();"
            ]
          }
        }
      ]
    },
