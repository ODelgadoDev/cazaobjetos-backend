              "const csrfData=pm.response.json();pm.environment.set(\"csrfHeader\",csrfData.headerName);pm.environment.set(\"csrfToken\",csrfData.token);",
              "}",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "04 · Login alumno demo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "{{csrfHeader}}",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "alumno.demo@utch.edu.mx",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{devPassword}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function(){",
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "if(pm.response.code === 204) {",
              "",
              "}",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "05 · Obtener CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function(){",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
