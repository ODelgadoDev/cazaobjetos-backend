              "}",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "06 · Publicar found-items",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/found-items",
        "header": [
          {
            "key": "{{csrfHeader}}",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Prueba de fotograf\\u00edas\", \"description\": \"Publicaci\\u00f3n para probar im\\u00e1genes\", \"category\": \"OTHER\", \"location\": \"Edificio I\", \"occurredOn\": \"2026-10-01\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function(){",
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.environment.set(\"photoFoundId\",pm.response.json().id);",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "07 · Subir PNG",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/found-items/{{photoFoundId}}/photos",
        "header": [
          {
            "key": "{{csrfHeader}}",
            "value": "{{csrfToken}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "fixtures/photo.png"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function(){",
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201) pm.environment.set(\"photoId\",pm.response.json().id);",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "08 · Listar fotos",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/found-items/{{photoFoundId}}/photos",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function(){",
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Una foto\",()=>pm.expect(pm.response.json().length).to.eql(1));",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "09 · Consultar imagen",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/found-items/{{photoFoundId}}/photos/{{photoId}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function(){",
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"PNG\",()=>pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"image/png\"));",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "10 · Eliminar foto",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/found-items/{{photoFoundId}}/photos/{{photoId}}",
