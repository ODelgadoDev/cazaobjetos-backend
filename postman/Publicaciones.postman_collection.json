        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "alumno.demo@utch.edu.mx",
              "type": "text"
            },
            {
              "key": "password",
              "value": "{{devPassword}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
