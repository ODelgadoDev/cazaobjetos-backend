{
  "info": {
    "name": "CazaObjetos · Gestión de publicaciones",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Usa el entorno CazaObjetos Local con devPassword configurado. Crea dos hallazgos y un extravío ficticios; verifica filtros, órdenes y paginación. No elimina registros."
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "01 · Obtener CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function(){",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if(pm.response.code === 200) {",
              "const csrfData=pm.response.json();pm.environment.set(\"csrfHeader\",csrfData.headerName);pm.environment.set(\"csrfToken\",csrfData.token);",
              "}",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Cerrar sesión previa",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "{{csrfHeader}}",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function(){",
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
              "if(pm.response.code === 204) {",
              "",
              "}",
              "})();"
            ]
          }
        }
      ]
    },
