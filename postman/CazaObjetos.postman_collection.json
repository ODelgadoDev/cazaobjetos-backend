{
  "info": {
    "name": "CazaObjetos UTCH · Flujo MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar de arriba abajo con el entorno Local y perfil dev. Crea datos ficticios nuevos en cada ejecución. Los 400/401/403/409 indicados son resultados esperados. Usa sesión y CSRF, no Bearer Token."
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "01 · Obtener token CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/csrf"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.environment.set(\"csrfHeader\", data.headerName);",
              "  pm.environment.set(\"csrfToken\", data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Cerrar sesión",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "{{csrfHeader}}",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
